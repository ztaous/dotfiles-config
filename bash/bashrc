case $- in
  *i*) ;;
  *) return ;;
esac

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

sync_history() {
  history -a
  history -n
}

case ";${PROMPT_COMMAND:-};" in
  *";sync_history;"*) ;;
  *) PROMPT_COMMAND="sync_history${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

prompt_git_branch() {
  local branch
  branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || return
  printf ' (%s)' "$branch"
}

PROMPT_DIRTRIM=3
PS1='\[\e[32m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0;35m\]$(prompt_git_branch)\[\e[0m\] \$ '

if command -v fzf >/dev/null 2>&1; then
  fzf_init="$(fzf --bash 2>/dev/null)" && eval "$fzf_init"
  unset fzf_init
fi
